<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.stefan.plaud-pipeline</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/node</string>
        <string>/Users/stefan/bin/plaud-pipeline-server.mjs</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PORT</key>
        <string>8791</string>
        <key>PLAUD_HTML</key>
        <string>/Users/stefan/Desktop/plaud-pipeline.html</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>5</integer>

    <key>StandardOutPath</key>
    <string>/Users/stefan/Library/Logs/plaud-pipeline.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/stefan/Library/Logs/plaud-pipeline.log</string>
</dict>
</plist>
